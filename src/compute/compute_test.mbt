///|
test "wave positions stay on exact dyadic x values" {
  assert_eq(@compute.WORKGROUP_SIZE, 64)
  assert_eq(@compute.workgroup_count(0), 0)
  assert_eq(@compute.workgroup_count(1), 1)
  assert_eq(@compute.workgroup_count(64), 1)
  assert_eq(@compute.workgroup_count(65), 2)
  let end = @compute.wave_position(0, 5, 0.0)
  let mid = @compute.wave_position(2, 5, 0.0)
  let tip = @compute.wave_position(4, 5, 0.0)
  assert_eq(end.x, -1.0)
  assert_eq(mid.x, 0.0)
  assert_eq(mid.y, 0.0)
  assert_eq(mid.z, 0.0)
  assert_eq(tip.x, 1.0)
  let positions = @compute.StoragePositions::new(0)
  assert_eq(positions.count, 1)
  let wave = @compute.StoragePositions::new(5)
  wave.set_time(0.5)
  assert_eq(wave.time, 0.5)
  let position = wave.geometry.get_attribute("position").unwrap()
  assert_eq(position.count, 5)
  assert_eq(position.get_x(0), -1.0)
  assert_eq(position.get_x(2), 0.0)
  assert_eq(position.get_x(4), 1.0)
  assert_eq(position.get_y(2) == 0.0, false)
  let packed = @compute.pack_wave_params(1.0, 2)
  assert_eq(packed.length(), 16)
  assert_eq(packed[0], b'\x00')
  assert_eq(packed[1], b'\x00')
  assert_eq(packed[2], b'\x80')
  assert_eq(packed[3], b'\x3F')
  assert_eq(packed[4], b'\x00')
  assert_eq(packed[5], b'\x00')
  assert_eq(packed[6], b'\x00')
  assert_eq(packed[7], b'\x40')
  let wgsl = @compute.wave_wgsl()
  assert_eq(wgsl.contains("@workgroup_size(64)"), true)
  assert_eq(wgsl.contains("var<storage, read_write>"), true)
  assert_eq(wgsl.contains("3.141592653589793"), true)
  assert_eq(wgsl.contains("* 0.5"), true)
}
