pub fn Material::prefixed_fragment_shader(
  self : Material,
  has_tangent~ : Bool = false,
  has_vertex_alpha~ : Bool = false,
  has_points_uv~ : Bool = false,
  shadow_map_enabled~ : Bool = false,
  shadow_map_pcf~ : Bool = false,
  shadow_map_vsm~ : Bool = false,
  num_light_probes~ : Int = 0,
  num_light_probe_grids~ : Int = 0,
  decode_video_texture~ : Bool = false,
  decode_video_texture_emissive~ : Bool = false,
  logarithmic_depth_buffer~ : Bool = false,
  reversed_depth_buffer~ : Bool = false,
  tone_mapping~ : @constants.ToneMapping = @constants.No,
  output_srgb~ : Bool = true,
  depth_packing~ : Int = -1,
) -> String {
  if self.is_shader_material && !self.is_raw_shader_material {
    shader_version_line() +
    glsl3_fragment_defines(self.glsl_version) +
    precision_prefix(self.precision) +
    shader_type_line(self.type_name) +
    shader_name_line(self.name) +
    custom_define_lines(self.defines) +
    use_map_line(self.map) +
    use_envmap_line(self.env_map) +
    envmap_type_line(self.env_map) +
    envmap_mode_line(self.env_map) +
    envmap_blending_line(self.env_map, self.combine) +
    use_lightmap_line(self.light_map) +
    use_aomap_line(self.ao_map) +
    use_bumpmap_line(self.bump_map) +
    use_normalmap_line(self.normal_map) +
    normalmap_object_line(self.normal_map, self.normal_map_type) +
    normalmap_tangent_line(self.normal_map, self.normal_map_type) +
    use_emissivemap_line(self.emissive_map) +
    use_anisotropy_line(self.anisotropy) +
    use_anisotropymap_line(self.anisotropy, self.anisotropy_map) +
    use_clearcoat_line(self.clearcoat) +
    use_clearcoatmap_line(self.clearcoat, self.clearcoat_map) +
    use_clearcoat_roughnessmap_line(self.clearcoat, self.clearcoat_roughness_map) +
    use_clearcoat_normalmap_line(self.clearcoat, self.clearcoat_normal_map) +
    use_iridescencemap_line(self.iridescence, self.iridescence_map) +
    use_iridescence_thicknessmap_line(
      self.iridescence,
      self.iridescence_thickness_map,
    ) +
    use_specularmap_line(self.specular_map) +
    use_specular_colormap_line(self.specular_color_map) +
    use_specular_intensitymap_line(self.specular_intensity_map) +
    use_roughnessmap_line(self.roughness_map) +
    use_metalnessmap_line(self.metalness_map) +
    use_alphamap_line(self.alpha_map) +
    use_alphahash_line(self.alpha_hash) +
    use_sheen_colormap_line(self.sheen, self.sheen_color_map) +
    use_sheen_roughnessmap_line(self.sheen, self.sheen_roughness_map) +
    use_transmission_line(self.transmission) +
    use_transmissionmap_line(self.transmission, self.transmission_map) +
    use_thicknessmap_line(self.transmission, self.thickness_map) +
    use_tangent_line(
      has_tangent,
      self.normal_map,
      self.anisotropy,
      self.wireframe,
      self.flat_shading,
    ) +
    use_color_line(self.vertex_colors) +
    use_color_alpha_line(self.vertex_colors, has_vertex_alpha) +
    self.use_uv1_line() +
    self.use_uv2_line() +
    self.use_uv3_line() +
    use_points_uv_line(has_points_uv, self.map, self.alpha_map) +
    use_gradientmap_line(self.gradient_map) +
    flat_shaded_line(self.wireframe, self.flat_shading) +
    double_sided_line(self.side) +
    flip_sided_line(self.side) +
    use_shadowmap_line(shadow_map_enabled) +
    shadowmap_type_line(shadow_map_enabled, shadow_map_pcf, shadow_map_vsm) +
    premultiplied_alpha_line(self.premultiplied_alpha) +
    use_light_probes_line(num_light_probes) +
    use_light_probes_grid_line(num_light_probe_grids) +
    decode_video_texture_line(decode_video_texture) +
    decode_video_texture_emissive_line(decode_video_texture_emissive) +
    use_logarithmic_depth_buffer_line(logarithmic_depth_buffer) +
    use_reversed_depth_buffer_line(reversed_depth_buffer) +
    builtin_fragment_uniform_prefix() +
    tone_mapping_line(tone_mapping) +
    dithering_line(self.dithering, tone_mapping) +
    opaque_line(
      self.transparent,
      self.blending,
      self.alpha_to_coverage,
      self.dithering,
      tone_mapping,
    ) +
    colorspace_pars_line(
      self.transparent,
      self.blending,
      self.alpha_to_coverage,
      self.dithering,
      tone_mapping,
    ) +
    texel_encoding_line(output_srgb) +
    luminance_line() +
    depth_packing_line(depth_packing) +
    "\n" +
    self.fragment_shader
  } else {
    self.fragment_shader
  }
}

///|
/// 把数字 uniform 复制成一张新表。改目标里的数不会改到源。
/// r186: `cloneUniforms` https://github.com/mrdoob/three.js/blob/r186/src/renderers/shaders/UniformsUtils.js#L18
fn copied_uniforms(source : Map[String, Double]) -> Map[String, Double] {
  let copied : Map[String, Double] = Map([])
  for pair in source.iter() {
    let (key, value) = pair
    copied.set(key, value)
  }
  copied
}

///|
let next_uniforms_group_id : Ref[Int] = Ref::Ref(0)

///|
fn fresh_uniforms_group_id() -> Int {
  let id = next_uniforms_group_id.val
  next_uniforms_group_id.val = id + 1
  id
}

///|
/// 一组 uniform。渲染器会把它收成一个 UBO。这一刀存编号、名字、`usage`、一组数字和监听表。颜色、向量、数组和贴图仍不进组。`dispose` 只通知 `dispose` 监听。
/// r186: `UniformsGroup` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L15 ; `id` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L40 ; `name` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L47 ; `usage` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L55 ; `uniforms` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L62 ; `dispose` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L130
pub(all) struct UniformsGroup {
  id : Int
  mut name : String
  mut usage : Int
  mut uniforms : Array[Double]
  listeners : Map[String, Array[() -> Unit]]
}

///|
/// 新建一组。名字默认空，`usage` 默认 `35044`，数字列表和监听表默认空。编号从 `0` 起递增。
/// r186: `UniformsGroup` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L20
pub fn UniformsGroup::new(name? : String = "") -> UniformsGroup {
  {
    id: fresh_uniforms_group_id(),
    name,
    usage: @constants.STATIC_DRAW_USAGE,
    uniforms: [],
    listeners: Map([]),
  }
}

///|
/// 把一个数字追加进组，并返回这一组。颜色、向量、数组和贴图仍不能加进来。
/// r186: `add` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L72
pub fn UniformsGroup::add(self : UniformsGroup, value : Double) -> UniformsGroup {
  self.uniforms.push(value)
  self
}

///|
/// 从组里去掉第一次出现的这个数字，并返回这一组。没有这个数字时列表不变。
/// r186: `remove` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L86
pub fn UniformsGroup::remove(
  self : UniformsGroup,
  value : Double,
) -> UniformsGroup {
  let mut found = None
  for i in 0..<self.uniforms.length() {
    if found is None && self.uniforms[i] == value {
      found = Some(i)
    }
  }
  match found {
    None => ()
    Some(index) => ignore(self.uniforms.remove(index))
  }
  self
}

///|
/// 改这一组的名字，并返回这一组。
/// r186: `setName` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L102
pub fn UniformsGroup::set_name(
  self : UniformsGroup,
  name : String,
) -> UniformsGroup {
  self.name = name
  self
}

///|
/// 改这一组的 `usage`，并返回这一组。`35044` 是静态绘制，`35048` 是动态绘制。
/// r186: `setUsage` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L116
pub fn UniformsGroup::set_usage(
  self : UniformsGroup,
  value : Int,
) -> UniformsGroup {
  self.usage = value
  self
}

///|
/// 登记一个监听。同一种事件里，同一个函数只保留一次。
/// r186: `addEventListener` https://github.com/mrdoob/three.js/blob/r186/src/core/EventDispatcher.js#L31
pub fn UniformsGroup::add_event_listener(
  self : UniformsGroup,
  kind : String,
  listener : () -> Unit,
) -> Unit {
  let listeners = self.listeners.get_or_init(kind, fn() { [] })
  let mut found = false
  for existing in listeners {
    if physical_equal(existing, listener) {
      found = true
    }
  }
  if !found {
    listeners.push(listener)
  }
}

///|
/// 同一种事件里是否已经有这个监听。
/// r186: `hasEventListener` https://github.com/mrdoob/three.js/blob/r186/src/core/EventDispatcher.js#L58
pub fn UniformsGroup::has_event_listener(
  self : UniformsGroup,
  kind : String,
  listener : () -> Unit,
) -> Bool {
  match self.listeners.get(kind) {
    None => false
    Some(listeners) => {
      let mut found = false
      for existing in listeners {
        if physical_equal(existing, listener) {
          found = true
        }
      }
      found
    }
  }
}

///|
/// 从一种事件里移除这个监听。没有登记时不动。
/// r186: `removeEventListener` https://github.com/mrdoob/three.js/blob/r186/src/core/EventDispatcher.js#L74
pub fn UniformsGroup::remove_event_listener(
  self : UniformsGroup,
  kind : String,
  listener : () -> Unit,
) -> Unit {
  match self.listeners.get(kind) {
    None => ()
    Some(listeners) => {
      let mut index = None
      for i in 0..<listeners.length() {
        if physical_equal(listeners[i], listener) {
          index = Some(i)
        }
      }
      match index {
        None => ()
        Some(index) => ignore(listeners.remove(index))
      }
    }
  }
}

///|
/// 按名字通知已经登记的监听。调用期间改列表不会漏掉这一轮快照。
/// r186: `dispatchEvent` https://github.com/mrdoob/three.js/blob/r186/src/core/EventDispatcher.js#L101
pub fn UniformsGroup::dispatch_event(self : UniformsGroup, kind : String) -> Unit {
  match self.listeners.get(kind) {
    None => ()
    Some(listeners) => {
      let snapshot = listeners.copy()
      for listener in snapshot {
        listener()
      }
    }
  }
}

///|
/// 通知 `dispose` 监听。其它事件不动。渲染器仍不因这次调用释放 GPU 缓冲。
/// r186: `dispose` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L130
pub fn UniformsGroup::dispose(self : UniformsGroup) -> Unit {
  self.dispatch_event("dispose")
}

///|
/// 新建一组，沿用名字、`usage` 和数字。编号是新的，数字数组是新的一份，监听表是空的。
/// r186: `clone` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L172
pub fn UniformsGroup::clone(self : UniformsGroup) -> UniformsGroup {
  {
    id: fresh_uniforms_group_id(),
    name: self.name,
    usage: self.usage,
    uniforms: copied_doubles(self.uniforms),
    listeners: Map([]),
  }
}

///|
/// 把源的名字、`usage` 和数字写进这一组。编号和监听留在目标上。数字写进目标原来的数组，改目标不改源。
/// r186: `copy` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L142
pub fn UniformsGroup::copy(
  self : UniformsGroup,
  source : UniformsGroup,
) -> UniformsGroup {
  self.name = source.name
  self.usage = source.usage
  self.uniforms.clear()
  for value in source.uniforms {
    self.uniforms.push(value)
  }
  self
}

///|
/// 把 uniform 组复制成一张新数组。每组拿新的编号，名字、`usage` 和数字列表跟着走。数字数组是新的一份。监听表留空。
/// r186: `cloneUniformsGroups` https://github.com/mrdoob/three.js/blob/r186/src/renderers/shaders/UniformsUtils.js#L114
/// r186: `clone` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L172
/// r186: `copy` https://github.com/mrdoob/three.js/blob/r186/src/core/UniformsGroup.js#L142
fn copied_uniforms_groups(
  source : Array[UniformsGroup],
) -> Array[UniformsGroup] {
  let copied : Array[UniformsGroup] = []
  for group in source {
    copied.push(group.clone())
  }
  copied
}

///|
/// 自定义着色器。`is_shader_material` 为真，`is_raw_shader_material` 为假，`type_name` 是 `ShaderMaterial`，`defines` 是空表。颜色仍是白，`transparent` 默认关闭，`fog` 默认关闭，`lights` 默认关闭，`clipping` 默认关闭，`vertex_shader` 是默认顶点着色器，`fragment_shader` 是默认片元着色器，`uniforms` 是空表，`uniforms_groups` 是空数组，`linewidth` 默认 `1`，`force_single_pass` 默认打开，`extensions` 的两个开关默认关闭，`default_attribute_values` 有 `color` `[1, 1, 1]`、`uv` `[0, 0]` 和 `uv1` `[0, 0]`，`glsl_version` 默认空，`index0_attribute_name` 默认空，`uniforms_need_update` 默认关闭。渲染器仍按 Basic 着色，场景雾只在 `fog` 打开时混入，仍不按 `lights` 传入光照，仍不按 `clipping` 传入裁剪平面，仍不编译这两串着色器，仍不读取 `uniforms`，仍不把 `uniforms_groups` 收成 UBO，仍按 1 像素画线。透明且双面时，这个开关打开就一次画完。仍不打开 `clip_cull_distance` 和 `multi_draw`。仍不把缺省顶点属性填进缺失的缓冲。仍不按 `index0_attribute_name` 调用 `bindAttribLocation`。仍不按 `uniforms_need_update` 强制上传 uniform。`prefixed_vertex_shader` 以 `#version 300 es` 开头，再写 `68` 个字符的顶点 GLSL3 改写，再加长 `833` 的内置 uniform 和 attribute。`prefixed_fragment_shader` 同样以这 16 个字符开头，再写 `464` 个字符的 GLSL3 宏和长 `82` 的内置 uniform。
/// r186: `isShaderMaterial` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L67
/// r186: `type` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L69
/// r186: `defines` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L89
/// r186: `vertexShader` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L127
/// r186: `fragmentShader` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L134
/// r186: `uniforms` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L113
/// r186: `uniformsGroups` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L120
/// r186: `linewidth` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L145
/// r186: `forceSinglePass` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L212
/// r186: `extensions` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L222
/// r186: `defaultAttributeValues` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L238
/// r186: `glslVersion` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L268
/// r186: `index0AttributeName` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L251
/// r186: `uniformsNeedUpdate` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L260
/// r186: `fog` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L186
/// r186: `lights` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L195
/// r186: `clipping` https://github.com/mrdoob/three.js/blob/r186/src/materials/ShaderMaterial.js#L204
pub fn Material::shader(
  hex? : Int = 0xFFFFFF,
  roughness? : Double = 1.0,
  metalness? : Double = 0.0,
) -> Material {
  {
    color: @math.Color::new().set_hex(hex),
    side: @constants.Front,
    shadow_side: None,
    opacity: 1.0,
    transparent: false,
    wireframe: false,
    map: None,
    roughness,
    metalness,
    fog: false,
    lights: false,
    clipping: false,
    vertex_shader: default_vertex_shader(),
    fragment_shader: default_fragment_shader(),
    uniforms: Map([]),
    uniforms_groups: [],
    default_attribute_values: fresh_default_attribute_values(),
    glsl_version: None,
    index0_attribute_name: None,
    uniforms_need_update: false,
    alpha_test: 0.0,
    flat_shading: false,
    depth_write: true,
    depth_test: true,
    depth_func: @constants.LessEqual,
    color_write: true,
    premultiplied_alpha: false,
    visible: true,
    force_single_pass: true,
    extensions: { clip_cull_distance: false, multi_draw: false },
    emissive: @math.Color::new(r=0.0, g=0.0, b=0.0),
    emissive_intensity: 1.0,
    emissive_map: None,
    roughness_map: None,
    metalness_map: None,
    alpha_map: None,
    normal_map: None,
    normal_map_type: @constants.TangentSpace,
    normal_scale: @math.Vector2::new(x=1.0, y=1.0),
    displacement_map: None,
    displacement_scale: 1.0,
    displacement_bias: 0.0,
    specular_map: None,
    env_map: None,
    env_map_rotation: @math.Euler::new(),
    combine: @constants.Combine::Multiply,
    reflectivity: 1.0,
    env_map_intensity: 1.0,
    refraction_ratio: 0.98,
    light_map: None,
    light_map_intensity: 1.0,
    ao_map: None,
    ao_map_intensity: 1.0,
    bump_map: None,
    gradient_map: None,
    matcap: None,
    bump_scale: 1.0,
    wireframe_linewidth: 1.0,
    linewidth: 1.0,
    wireframe_linecap: WireframeCap::Round,
    wireframe_linejoin: WireframeJoin::Round,
    defines: Map([]),
    anisotropy_rotation: 0.0,
    anisotropy_map: None,
    clearcoat_map: None,
    clearcoat_roughness: 0.0,
    clearcoat_roughness_map: None,
    clearcoat_normal_scale: @math.Vector2::new(x=1.0, y=1.0),
    clearcoat_normal_map: None,
    ior: 1.5,
    iridescence_map: None,
    iridescence_ior: 1.3,
    iridescence_thickness_range: fresh_iridescence_thickness_range(),
    iridescence_thickness_map: None,
    sheen_color: @math.Color::new(r=0.0, g=0.0, b=0.0),
    specular: @math.Color::new().set_hex(0x111111),
    shininess: 30.0,
    sheen_color_map: None,
    sheen_roughness: 1.0,
    sheen_roughness_map: None,
    transmission_map: None,
    thickness: 0.0,
    thickness_map: None,
    attenuation_distance: 1.0 / 0.0,
    attenuation_color: @math.Color::new(r=1.0, g=1.0, b=1.0),
    specular_intensity: 1.0,
    specular_intensity_map: None,
    specular_color: @math.Color::new(r=1.0, g=1.0, b=1.0),
    specular_color_map: None,
    anisotropy: 0.0,
    clearcoat: 0.0,
    iridescence: 0.0,
    dispersion: 0.0,
    retroreflectivity: 0.0,
    sheen: 0.0,
    transmission: 0.0,
    is_mesh_physical_material: false,
    is_mesh_toon_material: false,
    is_mesh_matcap_material: false,
    is_mesh_normal_material: false,
    is_mesh_depth_material: false,
    depth_packing: @constants.DepthPacking::Basic,
    is_mesh_distance_material: false,
    is_mesh_phong_material: false,
    is_shadow_material: false,
    is_shader_material: true,
    is_raw_shader_material: false,
    vertex_colors: false,
    tone_mapped: true,
    alpha_hash: false,
    alpha_to_coverage: false,
    dithering: false,
    polygon_offset: false,
    polygon_offset_factor: 0.0,
    polygon_offset_units: 0.0,
    clip_shadows: false,
    clip_intersection: false,
    allow_override: true,
    blend_alpha: 0.0,
    blend_color: @math.Color::new(r=0.0, g=0.0, b=0.0),
    blending: @constants.Normal,
    blend_src: @constants.SrcAlpha,
    blend_dst: @constants.OneMinusSrcAlpha,
    blend_equation: @constants.Add,
    blend_src_alpha: None,
    blend_dst_alpha: None,
    blend_equation_alpha: None,
    stencil_write_mask: 0xFF,
    stencil_func: @constants.StencilFunc::Always,
    stencil_ref: 0,
    stencil_func_mask: 0xFF,
    stencil_fail: @constants.StencilOp::Keep,
    stencil_z_fail: @constants.StencilOp::Keep,
    stencil_z_pass: @constants.StencilOp::Keep,
    stencil_write: false,
    clipping_planes: None,
    precision: None,
    user_data: Map([]),
    version: 0,
    id: fresh_material_id(),
    uuid: @math.generate_uuid(),
    name: "",
    type_name: "ShaderMaterial",
    kind: Shader,
    listeners: Map([]),
  }
}

///|
/// 不自动加上内置 uniform 和 attribute 的自定义着色器。`is_shader_material` 与 `is_raw_shader_material` 都为真，`type_name` 是 `RawShaderMaterial`，`kind` 是 `Raw`。其余默认值与 `Material::shader` 相同：颜色白，`fog`、`lights`、`clipping` 关闭，默认顶点着色器和片元着色器，`uniforms` 空表，`uniforms_groups` 空数组，`linewidth` 为 `1`，`force_single_pass` 打开，`extensions` 两个开关关闭，`default_attribute_values` 有 `color` `[1, 1, 1]`、`uv` `[0, 0]` 和 `uv1` `[0, 0]`，`glsl_version` 与 `index0_attribute_name` 为空，`uniforms_need_update` 关闭。`copy` 不改这两个标记、`type_name` 和 `kind`。渲染器仍按 Basic 着色，仍不编译这两串着色器。`prefixed_vertex_shader` 不加 `#version 300 es`，不加顶点 GLSL3 改写，也不加内置 uniform 和 attribute。`prefixed_fragment_shader` 不加这行版本，不加 GLSL3 宏，也不加内置 uniform。
/// r186: `RawShaderMaterial` https://github.com/mrdoob/three.js/blob/r186/src/materials/RawShaderMaterial.js#L12
/// r186: `isRawShaderMaterial` https://github.com/mrdoob/three.js/blob/r186/src/materials/RawShaderMaterial.js#L34
/// r186: `type` https://github.com/mrdoob/three.js/blob/r186/src/materials/RawShaderMaterial.js#L36
pub fn Material::raw(
  hex? : Int = 0xFFFFFF,
  roughness? : Double = 1.0,
  metalness? : Double = 0.0,
) -> Material {
  {
    color: @math.Color::new().set_hex(hex),
    side: @constants.Front,
    shadow_side: None,
    opacity: 1.0,
    transparent: false,
    wireframe: false,
    map: None,
    roughness,
    metalness,
    fog: false,
    lights: false,
    clipping: false,
    vertex_shader: default_vertex_shader(),
    fragment_shader: default_fragment_shader(),
    uniforms: Map([]),
    uniforms_groups: [],
    default_attribute_values: fresh_default_attribute_values(),
    glsl_version: None,
    index0_attribute_name: None,
    uniforms_need_update: false,
    alpha_test: 0.0,
    flat_shading: false,
    depth_write: true,
    depth_test: true,
    depth_func: @constants.LessEqual,
    color_write: true,
    premultiplied_alpha: false,
    visible: true,
    force_single_pass: true,
    extensions: { clip_cull_distance: false, multi_draw: false },
    emissive: @math.Color::new(r=0.0, g=0.0, b=0.0),
    emissive_intensity: 1.0,
    emissive_map: None,
    roughness_map: None,
    metalness_map: None,
    alpha_map: None,
    normal_map: None,
    normal_map_type: @constants.TangentSpace,
    normal_scale: @math.Vector2::new(x=1.0, y=1.0),
    displacement_map: None,
    displacement_scale: 1.0,
    displacement_bias: 0.0,
    specular_map: None,
    env_map: None,
    env_map_rotation: @math.Euler::new(),
    combine: @constants.Combine::Multiply,
    reflectivity: 1.0,
    env_map_intensity: 1.0,
    refraction_ratio: 0.98,
    light_map: None,
    light_map_intensity: 1.0,
    ao_map: None,
    ao_map_intensity: 1.0,
    bump_map: None,
    gradient_map: None,
    matcap: None,
    bump_scale: 1.0,
    wireframe_linewidth: 1.0,
    linewidth: 1.0,
    wireframe_linecap: WireframeCap::Round,
    wireframe_linejoin: WireframeJoin::Round,
    defines: Map([]),
    anisotropy_rotation: 0.0,
    anisotropy_map: None,
    clearcoat_map: None,
    clearcoat_roughness: 0.0,
    clearcoat_roughness_map: None,
    clearcoat_normal_scale: @math.Vector2::new(x=1.0, y=1.0),
    clearcoat_normal_map: None,
    ior: 1.5,
    iridescence_map: None,
    iridescence_ior: 1.3,
    iridescence_thickness_range: fresh_iridescence_thickness_range(),
    iridescence_thickness_map: None,
    sheen_color: @math.Color::new(r=0.0, g=0.0, b=0.0),
    specular: @math.Color::new().set_hex(0x111111),
    shininess: 30.0,
    sheen_color_map: None,
    sheen_roughness: 1.0,
    sheen_roughness_map: None,
    transmission_map: None,
    thickness: 0.0,
    thickness_map: None,
    attenuation_distance: 1.0 / 0.0,
    attenuation_color: @math.Color::new(r=1.0, g=1.0, b=1.0),
    specular_intensity: 1.0,
    specular_intensity_map: None,
    specular_color: @math.Color::new(r=1.0, g=1.0, b=1.0),
    specular_color_map: None,
    anisotropy: 0.0,
    clearcoat: 0.0,
    iridescence: 0.0,
    dispersion: 0.0,
    retroreflectivity: 0.0,
    sheen: 0.0,
    transmission: 0.0,
    is_mesh_physical_material: false,
    is_mesh_toon_material: false,
    is_mesh_matcap_material: false,
    is_mesh_normal_material: false,
    is_mesh_depth_material: false,
    depth_packing: @constants.DepthPacking::Basic,
    is_mesh_distance_material: false,
    is_mesh_phong_material: false,
    is_shadow_material: false,
    is_shader_material: true,
    is_raw_shader_material: true,
    vertex_colors: false,
    tone_mapped: true,
    alpha_hash: false,
    alpha_to_coverage: false,
    dithering: false,
    polygon_offset: false,
    polygon_offset_factor: 0.0,
    polygon_offset_units: 0.0,
    clip_shadows: false,
    clip_intersection: false,
    allow_override: true,
    blend_alpha: 0.0,
    blend_color: @math.Color::new(r=0.0, g=0.0, b=0.0),
    blending: @constants.Normal,
    blend_src: @constants.SrcAlpha,
    blend_dst: @constants.OneMinusSrcAlpha,
    blend_equation: @constants.Add,
    blend_src_alpha: None,
    blend_dst_alpha: None,
    blend_equation_alpha: None,
    stencil_write_mask: 0xFF,
    stencil_func: @constants.StencilFunc::Always,
    stencil_ref: 0,
    stencil_func_mask: 0xFF,
    stencil_fail: @constants.StencilOp::Keep,
    stencil_z_fail: @constants.StencilOp::Keep,
    stencil_z_pass: @constants.StencilOp::Keep,
    stencil_write: false,
    clipping_planes: None,
    precision: None,
    user_data: Map([]),
    version: 0,
    id: fresh_material_id(),
    uuid: @math.generate_uuid(),
    name: "",
    type_name: "RawShaderMaterial",
    kind: Raw,
    listeners: Map([]),
  }
}

///|
/// `MeshStandardMaterial`。`baseColor` 是 `color`，可再乘贴图。
/// r186: `MeshStandardMaterial` https://github.com/mrdoob/three.js/blob/r186/src/materials/MeshStandardMaterial.js#L41
pub(all) struct MeshStandardMaterial {
  material : Material
}

///|
pub fn MeshStandardMaterial::new(
  hex? : Int = 0xFFFFFF,
  roughness? : Double = 1.0,
  metalness? : Double = 0.0,
) -> MeshStandardMaterial {
  { material: Material::standard(hex~, roughness~, metalness~), }
}

///|
pub fn Material::shading(self : Material) -> @constants.Shading {
  match self.kind {
    Basic => @constants.Basic
    Lambert => @constants.Lambert
    Standard => @constants.Standard
    Physical => @constants.Standard
    Toon => @constants.Lambert
    Matcap => @constants.Basic
    Normal => @constants.Basic
    Depth => @constants.Basic
    Distance => @constants.Basic
    Phong => @constants.Lambert
    Shadow => @constants.Basic
    Shader => @constants.Basic
    Raw => @constants.Basic
  }
}

///|
/// 传入 `true` 时把 `version` 加一。传入 `false` 时计数不变。渲染器仍不因这次标记重新编译。
/// r186: `needsUpdate` https://github.com/mrdoob/three.js/blob/r186/src/materials/Material.js#L1227
pub fn Material::set_needs_update(self : Material, value : Bool) -> Unit {
  if value {
    self.version = self.version + 1
  }
}

///|
/// 写入 `alpha_test`。新值和旧值是否大于 `0` 发生变化时，把 `version` 加一。
/// r186: `alphaTest` https://github.com/mrdoob/three.js/blob/r186/src/materials/Material.js#L495
pub fn Material::set_alpha_test(self : Material, value : Double) -> Unit {
  if (self.alpha_test > 0.0) != (value > 0.0) {
    self.version = self.version + 1
  }
  self.alpha_test = value
}

///|
/// 写入各向异性强度。新值和旧值是否大于 `0` 发生变化时，把 `version` 加一。
/// r186: `anisotropy` https://github.com/mrdoob/three.js/blob/r186/src/materials/MeshPhysicalMaterial.js#L379
pub fn Material::set_anisotropy(self : Material, value : Double) -> Unit {
  if (self.anisotropy > 0.0) != (value > 0.0) {
    self.version = self.version + 1
  }
  self.anisotropy = value
}

