///|
fn custom_define_lines(defines : Map[String, String]) -> String {
  let mut text = ""
  let mut first = true
  for pair in defines.iter() {
    let (key, value) = pair
    if first {
      first = false
    } else {
      text = text + "\n"
    }
    text = text + "#define " + key + " " + value
  }
  if text.length() == 0 {
    ""
  } else {
    text + "\n"
  }
}

///|
fn shader_version_line() -> String {
  "#version 300 es\n"
}

///|
/// 片元着色器前面的版本行、GLSL3 改写和内置 uniform。Shader 以 `#version 300 es` 开头，这 16 个字符不看 `glsl_version`。空的 `glsl_version` 与 `GLSL1` 接着写 `464` 个字符的宏，其中有 `layout(location = 0)` 和 `gl_FragColor`。`GLSL3` 这两行留空，宏段变成 `382`。接着是长 `543` 的精度声明、长 `35` 的 `#define SHADER_TYPE ShaderMaterial`、空名字时长 `21` 的 `#define SHADER_NAME` 和长 `82` 的 uniform。Raw 和其它材质原样返回 `fragment_shader`。表里的每个键写成 `#define 键 值`。空表不加字符。有颜色贴图时再写 `#define USE_MAP`，连换行长 `16`。没有贴图不加。有环境贴图时再写 `#define USE_ENVMAP`，连换行长 `19`，接着写 `#define ENVMAP_TYPE_CUBE`，连换行长 `25`，再写 `#define ENVMAP_MODE_REFLECTION`，连换行长 `31`，然后按 `combine` 写混合。相乘是 `#define ENVMAP_BLENDING_MULTIPLY`，连换行长 `33`。混合与相加是 `ENVMAP_BLENDING_MIX` 和 `ENVMAP_BLENDING_ADD`，连换行都长 `28`。贴图还没有 mapping，所以类型固定是立方体、模式固定是反射。没有环境贴图这四行都不加。有光照贴图时再写 `#define USE_LIGHTMAP`，连换行长 `21`。没有光照贴图不加。有环境光遮蔽贴图时再写 `#define USE_AOMAP`，连换行长 `18`。没有环境光遮蔽贴图不加。有凹凸贴图时再写 `#define USE_BUMPMAP`，连换行长 `20`。没有凹凸贴图不加。有法线贴图时再写 `#define USE_NORMALMAP`，连换行长 `22`。物体空间再写 `#define USE_NORMALMAP_OBJECTSPACE`，连换行长 `34`。切线空间再写 `#define USE_NORMALMAP_TANGENTSPACE`，连换行长 `35`。两种类型只写其中一行。没有法线贴图这三行都不加。有自发光贴图时再写 `#define USE_EMISSIVEMAP`，连换行长 `24`。没有自发光贴图不加。各向异性大于 `0` 时再写 `#define USE_ANISOTROPY`，连换行长 `23`。等于 `0` 或小于 `0` 不加。大于 `0` 且有各向异性贴图时再写 `#define USE_ANISOTROPYMAP`，连换行长 `26`。没有贴图或各向异性不大于 `0` 不加。`clearcoat` 大于 `0` 时再写 `#define USE_CLEARCOAT`，连换行长 `22`。大于 `0` 且有清漆贴图时再写 `#define USE_CLEARCOATMAP`，连换行长 `25`。大于 `0` 且有清漆粗糙度贴图时再写 `#define USE_CLEARCOAT_ROUGHNESSMAP`，连换行长 `35`。大于 `0` 且有清漆法线贴图时再写 `#define USE_CLEARCOAT_NORMALMAP`，连换行长 `32`。等于 `0` 或小于 `0` 这些行都不加。顶点字符串只在有对应贴图且清漆大于 `0` 时写这三行贴图宏。彩虹大于 `0` 且有彩虹贴图时再写 `#define USE_IRIDESCENCEMAP`，连换行长 `27`。彩虹不大于 `0` 或不挂贴图不加。彩虹大于 `0` 且有厚度贴图时再写 `#define USE_IRIDESCENCE_THICKNESSMAP`，连换行长 `37`。没有厚度贴图不加。有高光贴图时再写 `#define USE_SPECULARMAP`，连换行长 `24`。没有高光贴图不加。有高光颜色贴图时再写 `#define USE_SPECULAR_COLORMAP`，连换行长 `30`。没有高光颜色贴图不加。有高光强度贴图时再写 `#define USE_SPECULAR_INTENSITYMAP`，连换行长 `34`。没有高光强度贴图不加。有粗糙度贴图时再写 `#define USE_ROUGHNESSMAP`，连换行长 `25`。没有粗糙度贴图不加。有金属度贴图时再写 `#define USE_METALNESSMAP`，连换行长 `25`。没有金属度贴图不加。有透明贴图时再写 `#define USE_ALPHAMAP`，连换行长 `21`。没有透明贴图不加。`alpha_hash` 打开时再写 `#define USE_ALPHAHASH`，连换行长 `22`。关闭不加。`transmission` 大于 `0` 时再写 `#define USE_TRANSMISSION`，连换行长 `25`。等于 `0` 或小于 `0` 不加。大于 `0` 且有透射贴图时再写 `#define USE_TRANSMISSIONMAP`，连换行长 `28`。没有贴图或透射不大于 `0` 不加。大于 `0` 且有厚度贴图时再写 `#define USE_THICKNESSMAP`，连换行长 `25`。没有厚度贴图不加。`sheen` 大于 `0` 且有光泽颜色贴图时，片元字符串在透射宏前面写 `#define USE_SHEEN_COLORMAP`，连换行长 `27`。大于 `0` 且有光泽粗糙度贴图时再写 `#define USE_SHEEN_ROUGHNESSMAP`，连换行长 `31`。`sheen` 不大于 `0` 或不挂对应贴图不加。几何带切线，并且有法线贴图或各向异性大于 `0`，而且平坦着色参数为假时，片元字符串在这些宏后面再写 `#define USE_TANGENT`，连换行长 `20`。`flat_shading` 打开且 `wireframe` 关闭时该参数为真，不加。没有切线、没有法线贴图且各向异性不大于 `0` 不加。缺法线的光照材质平坦着色留到后面。`vertex_colors` 打开时片元字符串再写 `#define USE_COLOR`，连换行长 `18`。关闭不加。实例色留到后面。`vertex_colors` 打开且颜色属性是四维时，片元字符串再写 `#define USE_COLOR_ALPHA`，连换行长 `24`。顶点色关闭或颜色不是四维不加。合批颜色留到后面。有贴图通道 `1` 时，片元字符串再写 `#define USE_UV1`，连换行长 `16`。通道 `0` 或其他通道不加。有贴图通道 `2` 时，片元字符串再写 `#define USE_UV2`，连换行长 `16`。通道 `0`、`1` 或其他通道不加。有贴图通道 `3` 时，片元字符串再写 `#define USE_UV3`，连换行长 `16`。通道 `0`、`1`、`2` 或其他通道不加。点对象带 `uv`，并且有颜色贴图或透明贴图时，片元字符串再写 `#define USE_POINTS_UV`，连换行长 `22`。没有这个标记，或两种贴图都没有，不加。`gradient_map` 有贴图时，片元字符串再写 `#define USE_GRADIENTMAP`，连换行长 `24`。空贴图不加。顶点字符串不加。`flat_shading` 打开且 `wireframe` 关闭时，片元字符串再写 `#define FLAT_SHADED`，连换行长 `20`。`wireframe` 打开或平坦着色关闭不加。缺法线的光照材质平坦着色留到后面。`side` 为双面时，片元字符串再写 `#define DOUBLE_SIDED`，连换行长 `21`。正面或背面不加。`side` 为背面时，片元字符串再写 `#define FLIP_SIDED`，连换行长 `19`。正面或双面不加。阴影贴图打开时，片元字符串再写 `#define USE_SHADOWMAP`，连换行长 `22`。关闭不加。阴影贴图打开时，片元字符串再写 `#define SHADOWMAP_TYPE_BASIC`，连换行长 `29`。关闭不加。PCF 阴影时，片元字符串改写 `#define SHADOWMAP_TYPE_PCF`，连换行长 `27`，不再写 `SHADOWMAP_TYPE_BASIC`。阴影贴图关闭仍不加。VSM 阴影时，片元字符串改写 `#define SHADOWMAP_TYPE_VSM`，连换行长 `27`，不再写 `SHADOWMAP_TYPE_BASIC` 或 `SHADOWMAP_TYPE_PCF`。阴影贴图关闭仍不加。`premultiplied_alpha` 打开时，片元字符串再写 `#define PREMULTIPLIED_ALPHA`，连换行长 `28`。关闭不加。顶点字符串不加。光照探针数量大于 `0` 时，片元字符串再写 `#define USE_LIGHT_PROBES`，连换行长 `25`。数量不大于 `0` 不加。光照探针网格数量大于 `0` 时，片元字符串再写 `#define USE_LIGHT_PROBES_GRID`，连换行长 `30`。数量不大于 `0` 不加。顶点字符串不加。`decode_video_texture` 打开时，片元字符串再写 `#define DECODE_VIDEO_TEXTURE`，连换行长 `29`。关闭不加。顶点字符串不加。`decode_video_texture_emissive` 打开时，片元字符串再写 `#define DECODE_VIDEO_TEXTURE_EMISSIVE`，连换行长 `38`。关闭不加。顶点字符串不加。对数深度打开时，片元字符串再写 `#define USE_LOGARITHMIC_DEPTH_BUFFER`，连换行长 `37`。关闭不加。反向深度打开时，片元字符串再写 `#define USE_REVERSED_DEPTH_BUFFER`，连换行长 `34`。关闭不加。`tone_mapping` 不是 `No` 时，片元字符串在内置 uniform 后面先补一个换行，再写 `#define TONE_MAPPING` 和换行，一共长 `22`，接着写入 `tonemapping_pars_fragment`。这块以换行开头、以换行结束，长 `5231`。两段合在一起长 `5253`。`No` 不加。顶点字符串不加。其它取值在 `tonemapping_pars_fragment` 后面先补一个换行，再写 `getToneMappingFunction` 生成的那一行和换行。`Linear` 写成 `vec3 toneMapping( vec3 color ) { return LinearToneMapping( color ); }`，这一行长 `69`，连前后换行长 `71`，片元字符串变成 `6546`。`Reinhard` 这一行长 `71`，`Cineon` 长 `69`，`ACES` 写成 `ACESFilmic` 长 `73`，`AgX` 长 `66`，`Neutral` 长 `70`。顶点字符串不加。`dithering` 打开时，片元字符串再写 `#define DITHERING`。`tone_mapping` 为 `No` 时，这一行前面补一个换行，连结尾换行一共长 `19`，片元字符串从 `1222` 变成 `1241`。`tone_mapping` 不是 `No` 时，色调映射函数那一行已经以换行结束，所以只再写宏和换行，长 `18`。`Linear` 时片元字符串变成 `6564`。关闭不加。顶点字符串不加。默认着色器材质不透明、混合是 `Normal`、`alpha_to_coverage` 关闭，片元字符串再写 `#define OPAQUE`。前面没有别的行时先补一个换行，连结尾换行一共长 `16`，片元字符串从 `1222` 变成 `1238`。`transparent` 打开、混合不是 `Normal`、或 `alpha_to_coverage` 打开时不加。`dithering` 或色调映射已经以换行结束时，只再写宏和换行，长 `15`。顶点字符串不加。非 Raw 的 Shader 接着写入 `colorspace_pars_fragment`。这块以两个换行开头、以换行结束，长 `496`。默认不透明时片元字符串从 `1238` 变成 `1734`。`transparent` 打开、混合不是 `Normal`、或 `alpha_to_coverage` 打开，并且没有 `dithering`、色调映射是 `No` 时，前面再补一个换行，片元字符串从 `1222` 变成 `1719`。顶点字符串不加。`getTexelEncodingFunction` 接在颜色空间块后面。默认 `output_srgb` 为真，写入 `vec4 linearToOutputTexel`，中间调用 `sRGBTransferOETF`，函数正文长 `179`，连前后换行长 `181`，片元字符串从 `1734` 变成 `1915`。`output_srgb` 为假时改叫 `LinearTransferOETF`，正文长 `181`，连前后换行长 `183`，片元字符串是 `1917`。顶点字符串不加。`getLuminanceFunction` 接在 `linearToOutputTexel` 后面。函数正文长 `123`，连前后换行长 `125`，片元字符串从 `1915` 变成 `2040`。权重是 `0.2126`、`0.7152`、`0.0722`。顶点字符串不加。`depth_packing` 小于 `0` 时不加。大于等于 `0` 时，片元字符串再写 `#define DEPTH_PACKING` 和这个整数。`3200` 连换行长 `27`，片元字符串从 `2040` 变成 `2067`。`0` 连换行长 `24`，片元字符串是 `2064`。顶点字符串不加。`prefixFragment` 末尾再写一个换行。默认片元字符串从 `2040` 变成 `2041`。`depth_packing` 为 `3200` 时从 `2067` 变成 `2068`。顶点字符串不加。`getUniforms` 按材质类型另取 uniform，不写进这两段前缀。`acquireProgram` 按缓存键另记引用次数，不写进这两段前缀。`releaseProgram` 按引用次数另从缓存移除，不写进这两段前缀。`releaseShaderCache` 按材质编号另放开着色器阶段，不写进这两段前缀。`dispose` 另清空着色器缓存，不写进这两段前缀。`getVertexShaderStage` 按顶点源码另取阶段，不写进这两段前缀。`getFragmentShaderStage` 按片元源码另取阶段，不写进这两段前缀。`customVertexShaderID` 另记自定义顶点阶段编号，不写进这两段前缀。`customFragmentShaderID` 另记自定义片元阶段编号，不写进这两段前缀。`shaderType` 另读材质类型名，不写进这两段前缀。`shaderName` 另读材质名字，不写进这两段前缀。`vertexShader` 另读自定义顶点源码，不写进这两段前缀。`fragmentShader` 另读自定义片元源码，不写进这两段前缀。`defines` 另读材质宏表，不写进这两段前缀。`isRawShaderMaterial` 另读 Raw 标记，不写进这两段前缀。`glslVersion` 另读 GLSL 版本，不写进这两段前缀。`precision` 另读精度参数，不写进这两段前缀。`getMaxPrecision` 另按浮点能力选精度，不写进这两段前缀。`batching` 另读合批标记，不写进这两段前缀。`batchingColor` 另读合批颜色，不写进这两段前缀。`instancing` 另读实例化标记，不写进这两段前缀。`instancingColor` 另读实例颜色，不写进这两段前缀。`instancingMorph` 另读实例形变，不写进这两段前缀。`outputColorSpace` 另选输出颜色空间，不写进这两段前缀。`alphaToCoverage` 另读这个开关，不写进这两段前缀。`map` 另读颜色贴图标记，不写进这两段前缀。`matcap` 另读 matcap 标记，不写进这两段前缀。`envMap` 另读环境贴图标记，不写进这两段前缀。`envMapMode` 另读环境贴图模式，不写进这两段前缀。`envMapCubeUVHeight` 另读立方 UV 高度，不写进这两段前缀。`aoMap` 另读环境光遮蔽贴图标记，不写进这两段前缀。`lightMap` 另读光照贴图标记，不写进这两段前缀。`bumpMap` 另读凹凸贴图标记，不写进这两段前缀。`normalMap` 另读法线贴图标记，不写进这两段前缀。`normalMapObjectSpace` 另读物体空间法线贴图标记，不写进这两段前缀。`normalMapTangentSpace` 另读切线空间法线贴图标记，不写进这两段前缀。`packedNormalMap` 另读打包法线贴图标记，不写进这两段前缀。`displacementMap` 另读位移贴图标记，不写进这两段前缀。`emissiveMap` 另读自发光贴图标记，不写进这两段前缀。`metalnessMap` 另读金属度贴图标记，不写进这两段前缀。`roughnessMap` 另读粗糙度贴图标记，不写进这两段前缀。`anisotropy` 另读各向异性标记，不写进这两段前缀。`anisotropyMap` 另读各向异性贴图标记，不写进这两段前缀。`clearcoat` 另读清漆标记，不写进这两段前缀。`clearcoatMap` 另读清漆贴图标记，不写进这两段前缀。`clearcoatNormalMap` 另读清漆法线贴图标记，不写进这两段前缀。`clearcoatRoughnessMap` 另读清漆粗糙度贴图标记，不写进这两段前缀。`dispersion` 另读色散标记，不写进这两段前缀。`retroreflection` 另读逆反射标记，不写进这两段前缀。`iridescence` 另读彩虹标记，不写进这两段前缀。`iridescenceMap` 另读彩虹贴图标记，不写进这两段前缀。`iridescenceThicknessMap` 另读彩虹厚度贴图标记，不写进这两段前缀。`sheen` 另读光泽标记，不写进这两段前缀。`sheenColorMap` 另读光泽颜