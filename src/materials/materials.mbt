/// r186: `alphaTest` https://github.com/mrdoob/three.js/blob/r186/src/renderers/webgl/WebGLPrograms.js#L267
pub fn Material::program_alpha_test(self : Material) -> Bool {
  self.alpha_test > 0.0
}

