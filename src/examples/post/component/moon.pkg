// 灰度全屏组件。导出形状与其它窗口组件相同。
warnings = "-44"

import {
  "fenriliuguang/three-mbt/examples/post/component/guest",
}

supported_targets = "+wasm"

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportAsyncStart:[callback][async-lift]start",
        "wasmExportStart:[async-lift]start",
      ],
    },
  },
)
