///|
test "render pipeline output is blue until a color pass is added" {
  let pipeline = @post.RenderPipeline::new()
  assert_eq(pipeline.output_color_transform, true)
  assert_eq(pipeline.needs_update, true)
  assert_eq(pipeline.output_is_blue(), true)
  assert_eq(pipeline.mapping is @constants.ToneMapping::No, true)
  assert_eq(pipeline.exposure, 1.0)
  assert_eq(pipeline.srgb, false)
  let blue = pipeline.clear_color()
  assert_eq(blue.r, 0.0)
  assert_eq(blue.g, 0.0)
  assert_eq(blue.b, 1.0)
  assert_eq(pipeline.take_update(), true)
  assert_eq(pipeline.needs_update, false)
  pipeline.set_mapping(@constants.ToneMapping::Linear)
  pipeline.set_exposure(2.0)
  assert_eq(pipeline.take_update(), true)
  let scaled = pipeline.clear_color()
  assert_eq(scaled.r, 0.0)
  assert_eq(scaled.g, 0.0)
  assert_eq(scaled.b, 1.0)
  pipeline.set_mapping(@constants.ToneMapping::Custom)
  pipeline.set_exposure(5.0)
  pipeline.set_srgb(true)
  let custom = pipeline.clear_color()
  assert_eq(custom.r, 0.0)
  assert_eq(custom.g, 0.0)
  assert_eq(custom.b, @math.linear_to_srgb(1.0))
  pipeline.set_output_color_transform(false)
  assert_eq(pipeline.output_color_transform, false)
  assert_eq(pipeline.take_update(), true)
  let raw = pipeline.clear_color()
  assert_eq(raw.b, 1.0)
  pipeline.add_grayscale(@post.GrayscalePass::new(amount=1.0))
  assert_eq(pipeline.output_is_blue(), false)
  assert_eq(pipeline.passes.pass_count(), 1)
}
