///|
test "mask pass keeps stencil values and skips the swap" {
  let scene = @scenes.Scene::new()
  let camera = @core.Object3D::new()
  let mask = @post.MaskPass::new(scene, camera)
  assert_eq(mask.inverse, false)
  assert_eq(mask.clear, true)
  assert_eq(mask.needs_swap(), false)
  assert_eq(mask.write_value(), 1)
  assert_eq(mask.clear_value(), 0)
  mask.set_inverse(true)
  assert_eq(mask.write_value(), 0)
  assert_eq(mask.clear_value(), 1)
  mask.set_clear(false)
  assert_eq(mask.clear, false)
  let clear = @post.ClearMaskPass::new()
  assert_eq(clear.needs_swap(), false)
  let chain = @post.EffectComposer::new()
  chain.add_grayscale(@post.GrayscalePass::new(amount=0.5))
  chain.add_mask(mask)
  chain.add_tone(@post.ToneMappingPass::new(mapping=@constants.ToneMapping::No))
  chain.add_clear_mask(clear)
  assert_eq(chain.pass_count(), 4)
  assert_eq(chain.passes[1].effect.needs_swap(), false)
  assert_eq(chain.passes[1].effect.writes_color(), false)
  assert_eq(chain.passes[3].effect.needs_swap(), false)
  assert_eq(chain.passes[3].effect.writes_color(), false)
  assert_eq(chain.is_last_enabled(0), false)
  assert_eq(chain.is_last_color(0), false)
  assert_eq(chain.is_last_color(1), false)
  assert_eq(chain.is_last_color(2), true)
  chain.set_enabled(2, false)
  assert_eq(chain.is_last_color(0), true)
  assert_eq(chain.any_color_enabled(), true)
  chain.set_enabled(0, false)
  assert_eq(chain.any_color_enabled(), false)
  assert_eq(chain.any_enabled(), true)
}
