///|
test "copy pass scales every channel by opacity" {
  let pass = @post.CopyPass::new()
  assert_eq(pass.opacity, 1.0)
  let kept = @post.copy_color(0.5, 0.25, 0.125, 1.0, pass.opacity)
  assert_eq(kept.0, 0.5)
  assert_eq(kept.1, 0.25)
  assert_eq(kept.2, 0.125)
  assert_eq(kept.3, 1.0)
  pass.set_opacity(0.5)
  let scaled = @post.copy_color(0.5, 0.25, 0.125, 1.0, pass.opacity)
  assert_eq(scaled.0, 0.25)
  assert_eq(scaled.1, 0.125)
  assert_eq(scaled.2, 0.0625)
  assert_eq(scaled.3, 0.5)
  let flipped = @post.copy_color(1.0, 0.0, 0.0, 1.0, -1.0)
  assert_eq(flipped.0, -1.0)
  assert_eq(flipped.1, 0.0)
  assert_eq(flipped.2, 0.0)
  assert_eq(flipped.3, -1.0)
  let chain = @post.EffectComposer::new()
  chain.add_copy(pass)
  assert_eq(chain.pass_count(), 1)
  assert_eq(chain.is_last_enabled(0), true)
  let packed = @post.pack_opacity(0.5)
  assert_eq(packed.length(), 16)
  assert_eq(packed[0], b'\x00')
  assert_eq(packed[1], b'\x00')
  assert_eq(packed[2], b'\x00')
  assert_eq(packed[3], b'\x3F')
  let wgsl = @post.copy_wgsl()
  assert_eq(wgsl.contains("params.opacity * texel"), true)
  assert_eq(wgsl.contains("0.5 - y * 0.5"), true)
}
